    {
        "id": "6deb441b1636fbca",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Normalisation Data",
        "func": "// Topic attendu : serre/ID_SERRE/plante/ID_PLANTE/data\n// Payload attendu : { \"encrypted\": \"...\", \"idp\": 1, \"ids\": 2 ... }\n\nlet data = msg.payload;\n\n// Sécurité JSON\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        node.error(\"JSON invalide\");\n        return null;\n    }\n}\n\n// Construction du message propre\nmsg.payload = {\n    encrypted: data.encrypted || \"\",\n    id_plante: data.idp || 0,\n    id_serre:  data.ids || 0,\n    rssi:      data.rssi || 0,\n    timestamp: data.ts || Math.floor(Date.now() / 1000),\n    topic_complet: msg.topic\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 580,
        "wires": [
            [
                "d2851a303273414d"
            ]
        ]
    },
    {
        "id": "d2851a303273414d",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Déchiffrer XTEA",
        "func": "// ========== CLE XTEA ==========\n// VERIFIEZ QUE CETTE CLE EST IDENTIQUE A L'ARDUINO\nconst XTEA_KEY = [0xA1B2C3D4, 0xE5F67890, 0x1A2B3C4D, 0x5E6F7809];\n\n// ========== ALGORYTHME ==========\nfunction xteaDec(v) {\n    let v0 = v[0], v1 = v[1];\n    const delta = 0x9E3779B9;\n    let sum = delta * 32;\n    \n    for (let i = 0; i < 32; i++) {\n        v1 -= (((v0 << 4) ^ (v0 >>> 5)) + v0) ^ (sum + XTEA_KEY[(sum >>> 11) & 3]);\n        v1 = v1 >>> 0;\n        sum -= delta;\n        sum = sum >>> 0;\n        v0 -= (((v1 << 4) ^ (v1 >>> 5)) + v1) ^ (sum + XTEA_KEY[sum & 3]);\n        v0 = v0 >>> 0;\n    }\n    return [v0, v1];\n}\n\nfunction decryptMessage(hex) {\n    if (!hex || typeof hex !== 'string') return \"\";\n    let out = \"\";\n    \n    for (let i = 0; i < hex.length; i += 16) {\n        let sub = hex.substring(i, i + 16);\n        if (sub.length < 16) break;\n        \n        let b = [\n            parseInt(sub.substring(0, 8), 16),\n            parseInt(sub.substring(8, 16), 16)\n        ];\n        \n        b = xteaDec(b);\n        \n        // Conversion en caractères\n        for (let k = 0; k < 2; k++) {\n            for (let j = 0; j < 4; j++) {\n                let byte = (b[k] >>> (j * 8)) & 0xFF;\n                if (byte !== 0) out += String.fromCharCode(byte);\n            }\n        }\n    }\n    return out.trim();\n}\n\nfunction extractValue(data, key) {\n    if (!data) return null;\n    const s = data.indexOf(key);\n    if (s === -1) return null;\n    const start = s + key.length;\n    let end = data.indexOf(';', start);\n    if (end === -1) end = data.length;\n    return data.substring(start, end);\n}\n\n// ========== EXECUTION ==========\ntry {\n    const decrypted = decryptMessage(msg.payload.encrypted);\n    \n    msg.payload.decrypted_raw = decrypted;\n    msg.payload.temperature = parseFloat(extractValue(decrypted, \"T=\"));\n    msg.payload.humidite = parseFloat(extractValue(decrypted, \"H=\"));\n    msg.payload.sol = parseInt(extractValue(decrypted, \"S=\"));\n    msg.payload.lumiere = parseInt(extractValue(decrypted, \"L=\"));\n\n    // Vérification basique\n    msg.payload.success = !isNaN(msg.payload.temperature);\n    \n    // Nettoyage\n    delete msg.payload.encrypted;\n    \n    return msg;\n} catch (e) {\n    node.error(\"Erreur XTEA: \" + e.message);\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 580,
        "wires": [
            [
                "9c981c7a427ea5a2"
            ]
        ]
    },
    {
        "id": "9c981c7a427ea5a2",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Formatage pour InfluxDB",
        "func": "// Récupération des données du simulateur (ou du déchiffreur)\nconst d = msg.payload;\n\n// 1. Sécurité : Vérification de la validité des données\nif (!d || d.success === false) {\n    node.warn(\"Données invalides ou échec de déchiffrement\");\n    return null;\n}\n\n// 2. Formatage pour InfluxDB (Structure compatible avec le nœud Influx Out)\n// Le nœud InfluxDB attend souvent un tableau de deux éléments : [fields, tags]\nmsg.payload = [\n    {\n        temperature: parseFloat(d.temperature),\n        humidite: parseFloat(d.humidite),\n        luminosite: parseInt(d.lumiere),\n        humidite_sol: parseInt(d.sol),\n        rssi: parseInt(d.rssi) || 0\n    },\n    {\n        id_plante: String(d.id_plante),\n        id_serre: String(d.id_serre),\n        location: \"maison\"\n    }\n];\n\n// 3. Métadonnées du point\nmsg.measurement = \"monitor_plante\";\n\n// Optionnel : Forcer le timestamp si vous voulez utiliser celui du simulateur\nif (d.timestamp) {\n    msg.timestamp = d.timestamp * 1000; // Conversion secondes vers millisecondes\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 580,
