    {
        "id": "eb13c7836dbdd2ea",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Mettre en Cache",
        "func": "let cache = context.get('db_cache') || [];\n// On garde le message complet pour le renvoyer plus tard\ncache.push(msg);\n// Limite de sécurité pour éviter de saturer la RAM (ex: 1000 points)\nif (cache.length > 1000) cache.shift();\n\ncontext.set('db_cache', cache);\nnode.status({fill:\"red\", shape:\"dot\", text: \"Stocké: \" + cache.length});\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
