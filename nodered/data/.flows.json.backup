    {
        "id": "69e0a953dfc0bae9",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Normalisation Data",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } \n    catch(e) { return null; }\n}\nmsg.payload = {\n    encrypted: data.encrypted || \"\",\n    id_plante: data.idp || 0,\n    id_serre:  data.ids || 0,\n    rssi:      data.rssi || 0,\n    timestamp: data.ts || Math.floor(Date.now() / 1000),\n    topic_complet: msg.topic\n};\nreturn msg;",
        "outputs": 1,
        "x": 290,
        "y": 320,
        "wires": [
            [
                "af882833c275db38"
            ]
        ]
    },
    {
        "id": "af882833c275db38",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Déchiffrer XTEA",
        "func": "const XTEA_KEY = [0xA1B2C3D4, 0xE5F67890, 0x1A2B3C4D, 0x5E6F7809];\n\nfunction xteaDec(v) {\n    let v0 = v[0], v1 = v[1];\n    const delta = 0x9E3779B9;\n    let sum = delta * 32;\n    for (let i = 0; i < 32; i++) {\n        v1 -= (((v0 << 4) ^ (v0 >>> 5)) + v0) ^ (sum + XTEA_KEY[(sum >>> 11) & 3]);\n        v1 = v1 >>> 0; sum -= delta; sum = sum >>> 0;\n        v0 -= (((v1 << 4) ^ (v1 >>> 5)) + v1) ^ (sum + XTEA_KEY[sum & 3]);\n        v0 = v0 >>> 0;\n    }\n    return [v0, v1];\n}\n\nfunction decryptMessage(hex) {\n    if (!hex) return \"\";\n    let out = \"\";\n    for (let i = 0; i < hex.length; i += 16) {\n        let sub = hex.substring(i, i + 16);\n        if (sub.length < 16) break;\n        let b = [parseInt(sub.substring(0, 8), 16), parseInt(sub.substring(8, 16), 16)];\n        b = xteaDec(b);\n        for (let k = 0; k < 2; k++) {\n            for (let j = 0; j < 4; j++) {\n                let byte = (b[k] >>> (j * 8)) & 0xFF;\n                if (byte !== 0) out += String.fromCharCode(byte);\n            }\n        }\n    }\n    return out.trim();\n}\n\nfunction extractValue(data, key) {\n    const s = data.indexOf(key);\n    if (s === -1) return null;\n    const start = s + key.length;\n    let end = data.indexOf(';', start);\n    if (end === -1) end = data.length;\n    return data.substring(start, end);\n}\n\ntry {\n    const decrypted = decryptMessage(msg.payload.encrypted);\n    msg.payload.temperature = parseFloat(extractValue(decrypted, \"T=\"));\n    msg.payload.humidite = parseFloat(extractValue(decrypted, \"H=\"));\n    msg.payload.sol = parseInt(extractValue(decrypted, \"S=\"));\n    msg.payload.lumiere = parseInt(extractValue(decrypted, \"L=\"));\n    msg.payload.success = !isNaN(msg.payload.temperature);\n    delete msg.payload.encrypted;\n    return msg;\n} catch (e) { return null; }",
        "outputs": 1,
        "x": 500,
        "y": 320,
        "wires": [
            [
                "aa5d7d1f5e5929ed"
            ]
        ]
    },
    {
        "id": "aa5d7d1f5e5929ed",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Formatage & Gestion Cache",
        "func": "let cache = context.get('db_cache') || [];\n\n// Si trigger par le répétiteur (retry)\nif (msg.topic === \"retry_cache\") {\n    if (cache.length > 0) {\n        let retryMsg = cache.shift();\n        context.set('db_cache', cache);\n        node.status({fill:\"yellow\", shape:\"dot\", text: \"Retry: \" + cache.length + \" restants\"});\n        return retryMsg;\n    }\n    node.status({fill:\"green\", shape:\"ring\", text: \"Cache vide\"});\n    return null;\n}\n\n// Formatage InfluxDB standard\nconst d = msg.payload;\nif (!d || d.success === false) return null;\n\nmsg.payload = [\n    {\n        temperature: parseFloat(d.temperature),\n        humidite: parseFloat(d.humidite),\n        luminosite: parseInt(d.lumiere),\n        humidite_sol: parseInt(d.sol),\n        rssi: parseInt(d.rssi) || 0\n    },\n    {\n        id_plante: String(d.id_plante),\n        id_serre: String(d.id_serre),\n        location: \"maison\"\n    }\n];\nmsg.measurement = \"monitor_plante\";\nif (d.timestamp) msg.timestamp = d.timestamp * 1000;\n\nnode.status({fill:\"blue\", shape:\"dot\", text: \"Envoi direct\"});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 320,
        "wires": [
            [
                "52b073bc90e401c3",
                "ea662e8d1b833503"
            ]
        ]
    },
